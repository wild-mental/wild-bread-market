# 복사해서 .env.local(로컬) 또는 Vercel Environment Variables(배포)에 값을 채운다. 이 파일에는 실제 값을 넣지 않는다.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# 관리자 Supabase 사용자 UUID (여러 명이면 쉼표로 구분)
ADMIN_USER_IDS=

# 앱 주소: 끝에 / 없이. 로컬은 http://localhost:3000
APP_BASE_URL=

# 카페24 개발자센터 > App 관리 > 개발정보 관리 > 인증정보
CAFE24_CLIENT_ID=
CAFE24_CLIENT_SECRET=

# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))" 결과
CAFE24_TOKEN_ENCRYPTION_KEY=

# ── 내 컴퓨터 전용 (npm run db:setup · npm run setup:check) — Vercel에는 넣지 않는다 ──
# Supabase 대시보드 Connect → Session pooler 접속 문자열. [YOUR-PASSWORD] 자리를 DB 비밀번호로 바꾼다(비밀값)
SUPABASE_DB_URL=
# 관리자 계정이 없으면 이 이메일로 만든다. 비밀번호는 파일에 두지 않고 실행할 때 입력한다
SETUP_ADMIN_EMAIL=
